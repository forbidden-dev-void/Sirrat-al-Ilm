# ---------------------------------------------------------------------------
# Sirrat al-Ilm — environment template
#
# Copy to `.env` (which is git-ignored) and change the values:
#     cp .env.example .env
#
# NEVER commit the real .env. Every secret below has a safe local default so the
# app runs out of the box for development.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | staging | production
ENVIRONMENT=development
DEBUG=false
APP_NAME=Sirrat al-Ilm
APP_TAGLINE=Slow brew. Deep insights.

# --- Security (CHANGE THESE) -----------------------------------------------
# Long random string used to sign JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30
# PBKDF2 cost factor (OWASP floor for SHA-256 is 210000)
PBKDF2_ITERATIONS=210000
MIN_PASSWORD_LENGTH=8

# --- Database --------------------------------------------------------------
# Local default (zero configuration):
DATABASE_URL=sqlite:///./data/sirrat_al_ilm.db
# Production example:
# DATABASE_URL=postgresql+psycopg://sirrat:sirrat_password@db:5432/sirrat_al_ilm
DATABASE_ECHO=false

# --- Administrator (owner-only account) ------------------------------------
# Signing in with this address always grants the admin console.
ADMIN_EMAIL=you@example.com
ADMIN_FULL_NAME=Site Owner
# Development convenience only. Leave EMPTY in production and instead run:
#   python -m app.cli create-admin
# ADMIN_SEED_PASSWORD=

# --- CORS / static ---------------------------------------------------------
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
SEED_CONTENT_ON_STARTUP=true
# Seed a demo learner account with sample progress so the dashboard can be
# reviewed. Set to false for a clean database (ENVIRONMENT=production also
# skips it automatically).
SEED_DEMO_LEARNER=true
# These demo credentials are PUBLIC BY DESIGN: the sign-in page prints them and
# offers a one-click fill. They are never the owner's credentials. The e-mail
# must be a real, validatable domain — reserved TLDs such as `.test` or `.local`
# are rejected by the e-mail validator and would lock the account out.
DEMO_LEARNER_EMAIL=learner@example.com
DEMO_LEARNER_PASSWORD=Learner123

# --- Public site metadata --------------------------------------------------
SITE_OWNER=Your Name
SITE_YOUTUBE_CHANNEL=https://www.youtube.com/@your-channel
SITE_CONTACT_EMAIL=you@example.com
